{
    "name": "maaz/laravel-zatca",
    "description": "Production-ready Laravel package for ZATCA Phase 1 and Phase 2 integrations.",
    "keywords": [
        "laravel",
        "zatca",
        "e-invoicing",
        "saas",
        "multi-tenant"
    ],
    "homepage": "https://github.com/maaz/laravel-zatca",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Maaz\\LaravelZatca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maaz\\LaravelZatca\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Maaz"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Maaz\\LaravelZatca\\ZatcaServiceProvider"
            ],
            "aliases": {
                "Zatca": "Maaz\\LaravelZatca\\Facades\\Zatca"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
